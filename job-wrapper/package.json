{
  "name": "@platforma-open/milaboratories.software-small-binaries.job-wrapper",
  "version": "1.0.0",
  "description": "Job container entrypoint replacing job-script.sh: runs the command, mirrors its streams, prunes the workdir, writes the completion marker and collects CPU/RAM usage from the container cgroup into .pl/usage.json",
  "scripts": {
    "cleanup": "rm -rf ./pkg-*.tgz && rm -rf ./build/ && rm -rf ./dist/",
    "build": "CGO_ENABLED=0 GO_LDFLAGS=\"-s -w -X main.version=${npm_package_version:-dev}\" ../scripts/build.sh './cmd/job-wrapper' 'job-wrapper' && pl-pkg build --all-platforms",
    "test": "./test.sh",
    "prepublishOnly": "pl-pkg prepublish"
  },
  "block-software": {
    "entrypoints": {
      "main": {
        "docker": {
          "artifact": {
            "type": "docker",
            "dockerfile": "Dockerfile",
            "context": "./build/linux-x64/"
          },
          "cmd": [
            "/app/job-wrapper"
          ]
        },
        "binary": {
          "artifact": {
            "registry": "platforma-open",
            "type": "binary",
            "roots": {
              "linux-x64": "./build/linux-x64/",
              "linux-aarch64": "./build/linux-aarch64/",
              "macosx-x64": "./build/macosx-x64/",
              "macosx-aarch64": "./build/macosx-aarch64/",
              "windows-x64": "./build/windows-x64/"
            }
          },
          "cmd": [
            "{pkg}/job-wrapper"
          ]
        }
      }
    }
  },
  "files": [
    "dist/"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@platforma-sdk/package-builder": "catalog:"
  }
}
